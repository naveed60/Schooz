# Schooz environment configuration
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase and database configuration
# Supabase secret key (or legacy service_role key), required for private uploads and jobs; server-only.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_STORAGE_BUCKET=private-files
DATABASE_URL=
DIRECT_URL=

# Feature flags
ENABLE_ANALYTICS=false