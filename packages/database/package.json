{
  "name": "@schooz/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:validate": "dotenv -e ../../.env -- prisma validate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "dotenv-cli": "^8.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
