generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlatformRole {
  PLATFORM_ADMIN
  SUPPORT
}

enum UserProfileStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  SCHOOL_OWNER
  SCHOOL_ADMIN
  TEACHER
  ACCOUNTANT
  EXAM_CONTROLLER
  RECEPTIONIST
  PARENT
  STUDENT
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum AuditActorType {
  USER
  PLATFORM_ADMIN
  SYSTEM
  WORKER
  ANONYMOUS
}

enum BackgroundJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model UserProfile {
  id          String            @id @db.Uuid
  email       String            @unique @db.VarChar(320)
  firstName   String            @db.VarChar(100)
  lastName    String            @db.VarChar(100)
  avatarUrl   String?           @db.VarChar(2048)
  platformRole PlatformRole?
  status      UserProfileStatus @default(INVITED)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  memberships SchoolMembership[]
  auditLogs   AuditLog[]       @relation("AuditActor")
  jobsCreated BackgroundJob[]  @relation("JobCreator")

  @@map("user_profiles")
}

model School {
  id           String            @id @default(uuid()) @db.Uuid
  name         String            @db.VarChar(160)
  slug         String            @unique @db.VarChar(80)
  email        String            @db.VarChar(320)
  timezone     String            @db.VarChar(64)
  currencyCode String            @db.Char(3)
  countryCode  String            @db.Char(2)
  status       SchoolStatus      @default(ACTIVE)
  approvedAt   DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  memberships  SchoolMembership[]
  auditLogs    AuditLog[]
  backgroundJobs BackgroundJob[]

  @@index([status, createdAt])
  @@map("schools")
}

model SchoolMembership {
  id        String           @id @default(uuid()) @db.Uuid
  schoolId  String           @db.Uuid
  userId    String           @db.Uuid
  role      MembershipRole
  status    MembershipStatus @default(INVITED)
  joinedAt  DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([userId, status])
  @@index([schoolId, status])
  @@map("school_memberships")
}

model AuditLog {
  id            String         @id @default(uuid()) @db.Uuid
  schoolId      String?        @db.Uuid
  actorUserId   String?        @db.Uuid
  actorType     AuditActorType
  action        String         @db.VarChar(120)
  entityType    String         @db.VarChar(120)
  entityId      String?        @db.VarChar(160)
  requestId     String?        @db.VarChar(120)
  ipAddress     String?        @db.VarChar(64)
  userAgent     String?        @db.VarChar(512)
  metadata      Json?
  previousValues Json?
  newValues     Json?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  school        School?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  actor         UserProfile?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([schoolId, entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model BackgroundJob {
  id              String              @id @default(uuid()) @db.Uuid
  schoolId        String?             @db.Uuid
  type            String              @db.VarChar(120)
  status          BackgroundJobStatus @default(QUEUED)
  idempotencyKey  String              @unique @db.VarChar(255)
  entityType      String?             @db.VarChar(120)
  entityId        String?             @db.VarChar(160)
  createdByUserId String?             @db.Uuid
  resultStorageKey String?            @db.VarChar(512)
  errorCode       String?             @db.VarChar(120)
  attempts        Int                 @default(0)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  startedAt       DateTime?           @db.Timestamptz(3)
  completedAt     DateTime?           @db.Timestamptz(3)
  school          School?             @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  createdBy       UserProfile?        @relation("JobCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([status, createdAt])
  @@map("background_jobs")
}
